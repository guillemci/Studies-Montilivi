<Window x:Class="DAO_PATTERN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAO Pattern - Proves"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connexió -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="DAOService:" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <ComboBox x:Name="cmbDAO"
                      Grid.Column="1"
                      Height="24"
                      SelectedIndex="0">
                <ComboBoxItem Content="CSV" Tag="CSV"/>
                <ComboBoxItem Content="BBDD" Tag="BBDD"/>
            </ComboBox>

            <TextBlock Grid.Column="2"
                       Text="Connexió / fitxer:"
                       Margin="15,0,6,0"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="txtConnexio"
                     Grid.Column="3"
                     Height="24"
                     VerticalContentAlignment="Center"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Tria fitxer..."
                        Width="95"
                        Margin="0,0,6,0"
                        Click="BtnConnexio_Click"/>
                <Button Content="Connectar"
                        Width="85"
                        Click="BtnConnectar_Click"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="tabsExercicis" Grid.Row="1" IsEnabled="False">

            <!-- EXERCICI 1 -->
            <TabItem Header="SelectByGenre">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Seleccionar per gènere"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="Gènere:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" x:Name="txtGenre" Margin="0,5,0,8"/>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fitxer de sortida:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="txtOutput1" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Triar..." Width="90" Click="BtnOutput1_Click"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Executar" Width="100" HorizontalAlignment="Left" Click="BtnExercici1_Click"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtResult1"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- EXERCICI 2 -->
            <TabItem Header="SelectByIndex">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Seleccionar per índex"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="Índex:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" x:Name="txtIndex2" Margin="0,5,0,8"/>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Executar" Width="100" HorizontalAlignment="Left" Click="BtnExercici2_Click"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtResult2"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- EXERCICI 3 -->
            <TabItem Header="SelectById">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Seleccionar per ID"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="ID:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" x:Name="txtId3" Margin="0,5,0,8"/>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Executar" Width="100" HorizontalAlignment="Left" Click="BtnExercici3_Click"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtResult3"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- EXERCICI 4 -->
            <TabItem Header="ReadTitles">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Llegir un bloc de títols"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="Índex inicial:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" x:Name="txtIndex4" Margin="0,5,0,8"/>

                    <TextBlock Grid.Row="3" Text="Quantitat:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" x:Name="txtLength4" Margin="0,5,0,8"/>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Executar" Width="100" HorizontalAlignment="Left" Click="BtnExercici4_Click"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtResult4"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- EXERCICI 5 -->
            <TabItem Header="PreMerge">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Preparar / ordenar un fragment"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="Índex inicial:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" x:Name="txtIndex5" Margin="0,5,0,8"/>

                    <TextBlock Grid.Row="3" Text="Quantitat:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" x:Name="txtLength5" Margin="0,5,0,8"/>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fitxer de sortida:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="txtOutput5" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Triar..." Width="90" Click="BtnOutput5_Click"/>
                        </Grid>

                        <Button Grid.Row="1" Content="Executar" Width="100" HorizontalAlignment="Left" Click="BtnExercici5_Click"/>
                        <TextBox Grid.Row="2"
                                 x:Name="txtResult5"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- EXERCICI 6 -->
            <TabItem Header="Merge">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Fer merge de dos fitxers"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fitxer d'entrada 1:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="txtInput6a" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Triar..." Width="90" Click="BtnInput6a_Click"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fitxer d'entrada 2:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="txtInput6b" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Triar..." Width="90" Click="BtnInput6b_Click"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fitxer de sortida:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="txtOutput6" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Triar..." Width="90" Click="BtnOutput6_Click"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Executar" Width="100" HorizontalAlignment="Left" Click="BtnExercici6_Click"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtResult6"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
